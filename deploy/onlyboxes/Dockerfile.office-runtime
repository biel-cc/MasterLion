ARG ONLYBOXES_RUNTIME_BASE=boen-registry-vpc.cn-shenzhen.cr.aliyuncs.com/biel_client/onlyboxes-runtime:0.7.1-lobehub
FROM ${ONLYBOXES_RUNTIME_BASE}

ARG TARGETARCH=amd64
ARG OFFICECLI_VERSION=1.0.143

ENV OFFICECLI_SKIP_UPDATE=1

USER root

RUN set -eu; \
    case "${TARGETARCH}" in \
      amd64) asset='officecli-linux-x64'; expected='6a29c598a789b57c92c03e560907d3f131a4bd0a068785b1d338a86fc31a58a7' ;; \
      arm64) asset='officecli-linux-arm64'; expected='c50298e4698fcd1b15fe1a0f096405ad260b5c84d4440882582d0bba1e57bd49' ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error \
      "https://github.com/iOfficeAI/OfficeCLI/releases/download/v${OFFICECLI_VERSION}/${asset}" \
      --output /usr/local/bin/officecli; \
    echo "${expected}  /usr/local/bin/officecli" | sha256sum --check --strict; \
    chmod 0755 /usr/local/bin/officecli; \
    officecli --version; \
    mkdir -p /tmp/masterino-office; \
    chmod 1777 /tmp/masterino-office
