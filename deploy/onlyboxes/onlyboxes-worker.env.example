# Copy to /etc/masterino/onlyboxes-worker.env and chmod 600.
# WORKER_ID and WORKER_SECRET are issued once by the Onlyboxes dashboard.
WORKER_CONSOLE_GRPC_TARGET=127.0.0.1:50051
WORKER_CONSOLE_INSECURE=true
WORKER_ID=CHANGE_ME
WORKER_SECRET=CHANGE_ME

# The exact same immutable runtime digest is used for both capabilities. Replace
# the placeholder only after the ACR build, SBOM, vulnerability scan, and golden
# workload have passed. Do not use a mutable tag in production.
WORKER_PYTHON_EXEC_DOCKER_IMAGE=boen-registry-vpc.cn-shenzhen.cr.aliyuncs.com/biel_client/onlyboxes-sandbox-runtime@sha256:CHANGE_ME
WORKER_TERMINAL_EXEC_DOCKER_IMAGE=boen-registry-vpc.cn-shenzhen.cr.aliyuncs.com/biel_client/onlyboxes-sandbox-runtime@sha256:CHANGE_ME

WORKER_HEARTBEAT_INTERVAL_SEC=5
WORKER_HEARTBEAT_JITTER_PCT=20
WORKER_CALL_TIMEOUT_SEC=15

# 30-concurrent N+1 baseline: four 16-vCPU / 32-GiB worker nodes, ten
# terminal slots per node. Losing one node leaves thirty terminal slots.
WORKER_PYTHON_EXEC_MEMORY_MIB=2048
WORKER_PYTHON_EXEC_CPUS=1.5
WORKER_PYTHON_EXEC_MAX_PROCESSES=256
WORKER_PYTHON_EXEC_MAX_INFLIGHT=10
WORKER_TERMINAL_EXEC_MEMORY_MIB=2048
WORKER_TERMINAL_EXEC_CPUS=1.5
WORKER_TERMINAL_EXEC_MAX_PROCESSES=256
WORKER_TERMINAL_EXEC_MAX_INFLIGHT=10
WORKER_TERMINAL_RESOURCE_MAX_INFLIGHT=10
WORKER_TERMINAL_SESSION_MAX_INFLIGHT=1
WORKER_TERMINAL_MAX_ACTIVE_SESSIONS=50

# Allows the bounded 10 MiB Masterino export fallback after base64 encoding.
WORKER_TERMINAL_OUTPUT_LIMIT_BYTES=16777216
