ARG NODEJS_VERSION="24"
FROM node:${NODEJS_VERSION}-slim AS builder
ENV CI=true
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY patches patches
COPY apps/market/package.json apps/market/package.json
RUN pnpm install --frozen-lockfile --filter @masterino/market... --prod=false
COPY apps/market apps/market
RUN pnpm --filter @masterino/market build && \
    mkdir -p apps/market/dist/migrations && \
    cp apps/market/src/migrations/*.sql apps/market/dist/migrations/ && \
    pnpm --config.inject-workspace-packages=true --filter @masterino/market --prod deploy /out

FROM node:${NODEJS_VERSION}-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /out ./
USER node
EXPOSE 3220 3221
CMD ["node", "dist/index.js"]
