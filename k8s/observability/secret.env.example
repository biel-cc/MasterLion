# Create the langfuse-secret from a non-repository secret file with these keys.
# URL-encode passwords before embedding them in connection strings.
DATABASE_URL=postgresql://langfuse_app:replace-me@current-masterino-postgres-host:5432/langfuse
DIRECT_URL=postgresql://langfuse_migrator:replace-me@current-masterino-postgres-host:5432/langfuse
SHADOW_DATABASE_URL=postgresql://langfuse_migrator:replace-me@current-masterino-postgres-host:5432/langfuse_shadow
REDIS_CONNECTION_STRING=redis://:replace-me@masterino-redis.masterlion.svc.cluster.local:6379/1
CLICKHOUSE_PASSWORD=replace-me
NEXTAUTH_SECRET=replace-me
SALT=replace-me
ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_replace-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_replace-me
LANGFUSE_INIT_USER_EMAIL=observability-admin@bielcrystal.com
LANGFUSE_INIT_USER_NAME=Observability Admin
LANGFUSE_INIT_USER_PASSWORD=replace-me
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=replace-me
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=replace-me
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=replace-me
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=replace-me
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=replace-me
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=replace-me
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me
