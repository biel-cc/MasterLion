# Generate a new production-only random value of at least 32 characters. It is
# shared only by the production Masterino server and Device Gateway.
SERVICE_TOKEN=replace-with-new-production-random-service-token

# Public-only RS256 JWKS derived from production masterino-secret/JWKS_KEY.
# Keep only kty, n, e, kid, alg and use. Never copy private RSA fields.
JWKS_PUBLIC_KEY={"keys":[{"kty":"RSA","n":"replace","e":"AQAB","kid":"replace","alg":"RS256","use":"sig"}]}
