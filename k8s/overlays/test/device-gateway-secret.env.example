# Generate a cryptographically random value of at least 32 characters.
SERVICE_TOKEN=replace-with-random-service-token

# Public-only RS256 JWKS derived from masterino-secret/JWKS_KEY. Never include
# d, p, q, dp, dq, qi, oth, or any other private RSA fields.
JWKS_PUBLIC_KEY={"keys":[{"kty":"RSA","n":"replace","e":"AQAB","alg":"RS256","use":"sig"}]}
