# Generate a cryptographically random value. It must match only the Masterino
# server's DEVICE_GATEWAY_SERVICE_TOKEN reference.
SERVICE_TOKEN=replace-with-random-service-token

# Public-only RS256 JWKS derived from masterino-secret/JWKS_KEY. Keep only kty,
# n, e, kid, alg and use. Never copy private RSA fields into this Secret.
JWKS_PUBLIC_KEY={"keys":[{"kty":"RSA","n":"replace","e":"AQAB","alg":"RS256","use":"sig"}]}
