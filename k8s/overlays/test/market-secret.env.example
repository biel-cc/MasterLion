# Create this file outside git and pass it to the guarded deployment script.
MARKET_DATABASE_PASSWORD=CHANGE_ME_URL_SAFE_PASSWORD
MARKET_DATABASE_URL=postgresql://masterino_market:CHANGE_ME_URL_SAFE_PASSWORD@masterino-postgres:5432/masterino_market
MARKET_REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@masterino-redis:6379/0
MARKET_TRUSTED_CLIENT_SECRET=lobehub-market_tcs_CHANGE_ME_64_HEX_CHARACTERS
MARKET_CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MARKET_IMPORT_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MARKET_RUNNER_INTERNAL_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
MARKET_OBJECT_STORAGE_ACCESS_KEY_ID=CHANGE_ME
MARKET_OBJECT_STORAGE_SECRET_ACCESS_KEY=CHANGE_ME
MARKET_OAUTH_CLIENTS_JSON={}
# Comma-separated Masterino user IDs allowed to review and administer the internal Market.
MARKET_ADMIN_USER_IDS=CHANGE_ME_MASTERINO_USER_ID
